node {
    def buildNumber = BUILD_NUMBER
    def imageName = "sioudkhouloul/java-web-app:${buildNumber}"

    stage("Git CheckOut") {
        git url: 'https://github.com/khouloudsioud7-web/java-web-app-docker.git',
            branch: 'master'
    }

    stage("Maven Clean Package") {
        def mavenHome = tool name: "Maven-3.6.1", type: "maven"
        def mavenCMD = "${mavenHome}/bin/mvn"
        sh "${mavenCMD} clean package"
    }

    stage("Build Docker Image") {
        sh "docker build -t ${imageName} ."
    }

    stage("Docker Push") {
        withCredentials([
            string(credentialsId: 'Docker_Hub_Pwd',
                   variable: 'DOCKERHUB_TOKEN')
        ]) {
            sh '''
                echo "$DOCKERHUB_TOKEN" | docker login \
                --username sioudkhouloul --password-stdin
            '''
        }

        sh "docker push ${imageName}"
    }

    stage("Remove Local Image") {
        sh "docker rmi -f ${imageName}"
    }

    stage("Deploy to Docker Swarm Cluster") {
        sshagent(['Docker_Swarm_Manager_Dev']) {
            sh '''
                ssh -o StrictHostKeyChecking=no khouloud@192.168.244.134 \
                "docker service rm javawebapp || true"

                ssh -o StrictHostKeyChecking=no khouloud@192.168.244.134 \
                "docker service create --name javawebapp \
                --publish 8080:8080 --replicas 2 \
                sioudkhouloul/java-web-app:${BUILD_NUMBER}"
            '''
        }
    }
}
